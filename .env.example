# Copy to .env and fill in. Never commit the filled-in file.

# --- Database ---------------------------------------------------------------
# Production: a real Postgres connection string.
DATABASE_URL=postgres://nexora:change-me@localhost:5432/nexora
# Used by docker compose to create that database.
POSTGRES_USER=nexora
POSTGRES_PASSWORD=change-me
POSTGRES_DB=nexora

# --- API security -----------------------------------------------------------
# At least 32 characters. Generate with: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRES_IN_SECONDS=28800
# Salt for hashing submitter IPs. Generate with: openssl rand -hex 16
IP_HASH_SALT=

# --- First admin account (seeded on first boot only) ------------------------
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Admin

# --- Public site ------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_CONTACT_EMAIL=
WEB_PORT=3000

# --- Email notifications (optional) -----------------------------------------
SMTP_URL=
NOTIFY_EMAIL_TO=
MAIL_FROM=

# --- Exchange rates (optional) ----------------------------------------------
# Any JSON endpoint returning { "rates": { "EUR": 1.17, "USD": 1.27 } } for a GBP base.
FX_PROVIDER_URL=
FX_REFRESH_HOURS=12

# --- Payments (optional) ----------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Shown to the customer on their proposal page.
PAYMENT_BANK_DETAILS=
